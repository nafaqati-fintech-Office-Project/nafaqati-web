# All browser calls go through the api-gateway only (never auth-service/user-service directly)
VITE_API_BASE_URL=http://localhost:8080

# Budget spend tracking (progress, alerts, Safe to Spend). Off by default.
VITE_BUDGET_TRACKING=false

# Subscriptions UI with in-memory demo data instead of subscription-service. Off by default.
VITE_SUBSCRIPTIONS_MOCK=false

# "Continue with Google": the OAuth Web client id (same value as GOOGLE_CLIENT_IDS in auth-service).
# VITE_GOOGLE_CLIENT_ID=123456789-abc.apps.googleusercontent.com
